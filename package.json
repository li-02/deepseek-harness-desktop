{
  "name": "deepseek-harness-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Desktop shell with an independently updatable DeepSeek Harness kernel",
  "author": "Local DeepSeek Harness Desktop",
  "repository": "https://github.com/li-02/deepseek-harness-desktop.git",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "runtime:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-node-runtime.ps1",
    "kernel:keygen": "node scripts/generate-signing-key.cjs",
    "kernel:bootstrap": "node scripts/build-kernel.cjs --bootstrap",
    "kernel:release": "node scripts/build-kernel.cjs --release",
    "pack": "electron-builder --dir --win --x64",
    "dist": "npm run dist:portable && npm run dist:installer",
    "dist:portable": "electron-builder --win portable --x64 --config.win.artifactName=DeepSeek-Harness-Desktop-Portable-${version}-${arch}.${ext}",
    "dist:installer": "electron-builder --win nsis --x64 --config.win.artifactName=DeepSeek-Harness-Desktop-Setup-${version}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop.local",
    "productName": "DeepSeek Harness",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "main.cjs",
      "preload.cjs",
      "kernel-common.cjs",
      "kernel-store.cjs",
      "kernel-updater.cjs",
      "kernel-update.json",
      "harness-path.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "build/icon.png",
      "build/kernel-public-key.pem"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "node.exe"
        ]
      },
      {
        "from": "build/kernel-bootstrap.tar.gz",
        "to": "kernel-bootstrap.tar.gz"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "DeepSeek-Harness-Desktop-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "semver": "^7.7.2",
    "tar": "^7.5.22"
  }
}
